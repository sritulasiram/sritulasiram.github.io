# Production HTTP Security Headers & Cache Configuration
# Supported by Cloudflare Pages, Netlify, and standard static edge hosts

/*
  # Enforce modern transport security (HTTPS only)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Prevent clickjacking / frame embedding
  X-Frame-Options: DENY

  # Referrer policy: send origin only on cross-origin requests
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser capabilities that the site does not use
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=()

  # Cross-Origin Isolation & Opener Policy
  Cross-Origin-Opener-Policy: same-origin

  # Prevent legacy XSS reflection
  X-XSS-Protection: 1; mode=block

# Static hashed assets: Immutable 1-year cache
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public media and images: 1-day fresh, 7-day stale-while-revalidate
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
